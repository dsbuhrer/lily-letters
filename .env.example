SITE_URL=http://localhost:5173
PORT=3001
NODE_ENV=development

# Optional: use when the frontend is NOT served by Vite (e.g. Apache/MAMP at /lily-letters/)
# VITE_API_URL=http://localhost:3001

# Supabase — server only (never VITE_ prefix)
# Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role secret (JWT longa, começa com eyJ) — NÃO use a anon key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# CMS admin (used only for initial seed)
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@thelilyletters.co
ADMIN_PASSWORD=change-me-on-first-login

# Optional: auto SEO for blog posts (Google AI Studio → API key)
GEMINI_API_KEY=
