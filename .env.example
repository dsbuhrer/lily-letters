SITE_URL=https://thelilyletters.co

# Supabase — Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Required at build time (Vite embeds into the static bundle)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# CMS admin (npm run seed creates Supabase Auth user + staff_roles)
ADMIN_EMAIL=admin@thelilyletters.co
ADMIN_PASSWORD=change-me-on-first-login

# Edge Function secrets (Supabase Dashboard → Edge Functions → Secrets)
# GEMINI_API_KEY=
# PAYONEER_WEBHOOK_SECRET=
# MOCK_CHECKOUT=false  # set to false when Payoneer is live

# Auto-deploy (Supabase trigger-rebuild + GitHub Actions) — see docs/AUTO_DEPLOY.md
# GH_DISPATCH_TOKEN=   # GitHub PAT with repo scope (Supabase secret only)
# WEBHOOK_SECRET=      # shared with Database Webhook header x-webhook-secret
# GitHub Actions secrets: VITE_*, SUPABASE_*, SITE_URL, FTP_SERVER, FTP_USERNAME, FTP_PASSWORD, FTP_SERVER_DIR
